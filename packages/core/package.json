    "test:pg": "node test/check-pg-url.mjs && vitest run"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/node": "22.10.7",
    "@types/pg": "8.11.10",
    "pg": "8.13.1",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ]
