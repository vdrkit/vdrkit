{
  "name": "@vdrkit/server",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:pg": "node ../../packages/core/test/check-pg-url.mjs && vitest run",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js",
    "seed:demo": "node --experimental-strip-types src/demo/seed-demo.ts",
    "openapi": "node scripts/export-openapi.mjs",
    "dev:pglite": "tsx --tsconfig tsconfig.dev.json scripts/dev/pglite.ts",
    "dev:sandbox": "tsx --tsconfig tsconfig.dev.json scripts/dev/sandbox.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1170.0",
    "@aws-sdk/s3-request-presigner": "3.1170.0",
    "@fastify/rate-limit": "11.3.0",
    "@fastify/swagger": "9.5.1",
    "@pdf-lib/fontkit": "1.1.1",
    "@vdrkit/core": "workspace:*",
    "better-auth": "1.7.13",
    "fastify": "5.12.6",
    "fastify-type-provider-zod": "7.0.0",
    "mupdf": "1.28.1",
    "nodemailer": "10.1.4",
    "pdf-lib": "1.17.1",
    "pg": "8.13.1",
    "pg-boss": "12.38.2",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.2.17",
    "@types/node": "26.6.6",
    "@types/pg": "8.11.10",
    "tsx": "4.19.3",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
