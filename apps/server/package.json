{
  "name": "@vdrkit/server",
  "version": "1.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.dev.json",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:pg": "node ../../packages/core/test/check-pg-url.mjs && vitest run",
    "start": "node dist/main.js",
    "worker": "node dist/worker-main.js",
    "seed:demo": "node --experimental-strip-types src/demo/seed-demo.ts",
    "openapi": "node scripts/export-openapi.mjs",
    "dev:pglite": "tsx --tsconfig tsconfig.dev.json scripts/dev/pglite.ts",
    "dev:sandbox": "tsx --tsconfig tsconfig.dev.json scripts/dev/sandbox.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1175.0",
    "@aws-sdk/s3-request-presigner": "3.1175.0",
    "@fastify/rate-limit": "10.2.1",
    "@fastify/swagger": "9.9.5",
    "@pdf-lib/fontkit": "1.1.1",
    "@vdrkit/core": "workspace:*",
    "better-auth": "1.7.27",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "6.1.0",
    "mupdf": "1.28.6",
    "nodemailer": "10.6.1",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "pg-boss": "10.1.5",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "22.10.7",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite": "6.4.5",
    "vitest": "4.1.12"
  }
}
