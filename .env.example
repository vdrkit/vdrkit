# VDRkit installation file. Copy to .env next to docker-compose.yml and fill in. Never commit .env.
# docker-compose.yml hands each service only the values it needs: the web front end gets no secret, only the migrate
# service gets the owner's password, and only Postgres gets POSTGRES_PASSWORD.
# Placeholders only. Before the first start, set every value marked CHANGE_ME, VDRKIT_MASTER_KEY and
# BETTER_AUTH_SECRET, and VDRKIT_BACKUP_PASSWORD if you turn on backups. Other empty values are optional; the comment
# above each says when you need it. Generate a database password with:  openssl rand -hex 24

# ---- Version and parts --------------------------------------------------------------------------------------------
# The version to run. Change it only when you upgrade (docs/install.md, "Upgrades").
VDRKIT_TAG=1.0.0
# Optional parts (docker-compose.yml): "postgres" the bundled Postgres 17, "clamav" the virus scanner, "backup" the
# daily backup. Remove "postgres" when DATABASE_URL points at Neon or another server.
COMPOSE_PROFILES=postgres,clamav

# ---- Web address --------------------------------------------------------------------------------------------------
# The address people use, for example dataroom.example.com. Caddy fetches the TLS certificate for it, so
# its DNS record must point at this machine and ports 80 and 443 must be reachable from the internet.
SITE_ADDRESS=dataroom.example.com
# With https://. Links in emails point here. Defaults to https://SITE_ADDRESS.
PUBLIC_URL=
# Where Caddy listens. Change only to run behind another proxy or for a local trial.
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Which proxies may set X-Forwarded-For. The default trusts private networks only, which fits the bundled Caddy.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ---- Database -----------------------------------------------------------------------------------------------------
# Bundled Postgres (profile "postgres"): set the four passwords and leave the three URLs below commented out; Compose
# builds them. POSTGRES_PASSWORD is the container superuser, used once by docker/postgres-init/01-roles.sh to create
# vdrkit_owner, vdrkit_app and vdrkit_queue, none of them a superuser. Use letters and digits only (openssl rand -hex),
# because the passwords go into connection URLs.
POSTGRES_PASSWORD=CHANGE_ME
VDRKIT_OWNER_PASSWORD=CHANGE_ME
VDRKIT_APP_PASSWORD=CHANGE_ME
VDRKIT_QUEUE_PASSWORD=CHANGE_ME
#
# Neon or another Postgres 16 or later: create the three roles as docs/install.md says ("Neon", "Roles"), remove
# "postgres" from COMPOSE_PROFILES, and set:
#   the app role, row-level security applies:
# DATABASE_URL=postgres://vdrkit_app:CHANGE_ME@host/vdrkit?sslmode=require
#   the owner, used only by the one-shot migrate service. A direct connection, never a pooler (Neon's "-pooler"
#   address, PgBouncer in transaction mode): the lock that stops two migrate runs at once is held by the connection.
# MIGRATION_DATABASE_URL=postgres://vdrkit_owner:CHANGE_ME@host/vdrkit?sslmode=require
#   the job queue (pg-boss), its own role with CREATE on the database; never vdrkit_app:
# QUEUE_DATABASE_URL=postgres://vdrkit_queue:CHANGE_ME@host/vdrkit?sslmode=require

# ---- Files --------------------------------------------------------------------------------------------------------
# "local" (the default) keeps files in the Docker volume "files" on this machine, encrypted. Back the volume up with
# the database. "s3" uses a bucket: AWS S3, Cloudflare R2 or a self-hosted store such as Garage (docs/install.md,
# "Self-hosted S3 with Garage"). Browsers upload straight to the bucket, so prepare it once with
# scripts/s3-bucket-setup.sh (browser uploads allowed from PUBLIC_URL, leftovers cleared).
STORAGE_DRIVER=local
# Leave empty for AWS S3. For example https://<account>.r2.cloudflarestorage.com or https://s3.example.com (Garage).
S3_ENDPOINT=
# The store's region name: "auto" for Cloudflare R2, the s3_region in garage.toml for Garage ("garage" by default).
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for Garage and most self-hosted stores.
S3_FORCE_PATH_STYLE=false

# ---- Keys ---------------------------------------------------------------------------------------------------------
# The master key that wraps every room's data key. Store a copy apart from your database backups: losing it makes
# every file unreadable, and so does changing it, since VDRkit cannot rotate it. Generate with: openssl rand -base64 32
VDRKIT_MASTER_KEY=
# Signs session cookies and encrypts authenticator secrets. At least 32 characters. Generate with:
# openssl rand -base64 32
BETTER_AUTH_SECRET=

# ---- Outgoing email -----------------------------------------------------------------------------------------------
# Invitations, sign-in codes and notifications. First-run setup (G1) asks for the mail server and saves it in Site
# settings, so these can stay empty. When set, setup starts from them. TLS is always required.
# SMTP_SECURE: "starttls" (default, port 587) or "tls" (port 465).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Alternative to SMTP_HOST and the rest: one URL, smtps:// for port 465. Percent-encode @ and : in the login.
# SMTP_URL=

# ---- Virus scanner ------------------------------------------------------------------------------------------------
# The bundled ClamAV (profile "clamav") answers at "clamav". Without it, set CLAMAV_HOST= (empty) and the Health tab
# shows a warning instead of a failure.
# CLAMAV_HOST=clamav
# Files up to this size, in bytes, are scanned, whatever their type. Default 1 GiB. Larger files go through unscanned,
# and the document's details say "Not scanned: larger than 1 GB." Raise it only together with the clamd limits in
# docker-compose.yml, and never above 2 GB.
# CLAMAV_MAX_BYTES=1073741824

# ---- Source code (AGPL-3.0) -------------------------------------------------------------------------------------
# "About and source code" in the account menu links to the source code of the version running here. Leave it empty for
# https://github.com/vdrkit/vdrkit. If you change VDRkit and let people use your changed copy, the AGPL requires you to
# offer them your source: set this to where you publish it.
# VDRKIT_SOURCE_URL=

# ---- Update check -------------------------------------------------------------------------------------------------
# Off unless set: VDRkit then never asks anyone about newer versions. When set, the Health tab in Site settings asks
# this address for the newest version every 6 hours (every hour after a failed try) and says when there is a newer one.
# The answer must be JSON naming the version in "version" or "tag_name", as GitHub's latest-release address below
# does; that address never names a pre-release. 1.1.0-rc.1 counts as older than 1.1.0.
# VDRKIT_UPDATE_URL=https://api.github.com/repos/vdrkit/vdrkit/releases/latest

# ---- Processes and memory -----------------------------------------------------------------------------------------
# One API process and one worker suit a server with 4 cores. On 8 cores, use 2 and 2 (docs/install.md, "Bigger
# servers"). Finish first-run setup before you raise API_REPLICAS.
API_REPLICAS=1
WORKER_REPLICAS=1
# Memory ceilings per container. A container that reaches its ceiling is restarted instead of exhausting the machine.
# The API streams uploads: in the load test it stayed under 300 MB for a 1 GB upload and under 1.3 GB for 50 readers.
# The worker holds a file in memory while it converts it and renders its pages, so keep it at 3g.
API_MEMORY_LIMIT=1536m
WORKER_MEMORY_LIMIT=3g
WEB_MEMORY_LIMIT=1g
# ClamAV: about 1 GB for its signatures, twice that while it loads new ones, plus the file it is scanning.
CLAMAV_MEMORY_LIMIT=3g

# ---- Backups (Compose profile "backup"; docs/install.md, "Backups" and "Restore")
# Add "backup" to COMPOSE_PROFILES for a daily backup of the database and the files volume.
# The password of the read-only role vdrkit_backup (docker/postgres-init/02-backup-role.sh). openssl rand -hex 24
VDRKIT_BACKUP_PASSWORD=
# Where backups go on this machine. Copy them off it as well (docs/install.md). They hold the database in clear
# text; the documents in them are encrypted, and VDRKIT_MASTER_KEY above is not in them.
BACKUP_DIR=./backups
# Time of the daily backup, UTC, and how many days backups are kept.
BACKUP_AT=02:30
BACKUP_KEEP_DAYS=14
# A failed backup (the database unreachable, a full disk) is tried again this many times, this many minutes apart.
BACKUP_RETRIES=3
BACKUP_RETRY_MINUTES=15
# With an outside database (Neon), a connection as a role that may read every row (see docs/install.md).
BACKUP_DATABASE_URL=

# ---- Development only ---------------------------------------------------------------------------------------------
# Not used by an installation. The demo data of `pnpm dev:stack` puts its people on subdomains of example.com
# (anika@seller.example.com, jan@bidder-a.example.com, ...), which receive no mail. To test real email from the dev
# stack, name domains you own: one domain for every side, or side=domain pairs for the seller side and Bidders A, B
# and C, for example seller=seller.test,a=bidder-a.test,b=bidder-b.test,c=bidder-c.test. The seed reads it only when
# it creates the demo data, so run `pnpm dev:stack -- --reset` after a change. Empty means example.com.
# VDRKIT_DEMO_EMAIL_DOMAINS=
